{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/ramlan", "destination": "/ramlanhadiansyah", "permanent": true },
    { "source": "/cv/ramlan", "destination": "/cv/ramlanhadiansyah", "permanent": true }
  ],
  "rewrites": [
    { "source": "/cv/:username([a-z0-9_]{3,25})", "destination": "/api/cv?username=:username" },
    { "source": "/page/:slug([a-z0-9_-]{1,25})", "destination": "/api/landing?slug=:slug" },
    { "source": "/api/trails-config", "destination": "/api/pol-price?action=trails-config" },
    { "source": "/sitemap.xml", "destination": "/api/landing?action=sitemap" },
    { "source": "/:username([a-z0-9_]{3,25})", "destination": "/api/bio?username=:username" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://esm.sh https://accounts.google.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/rollup-analytics", "schedule": "10 0 * * *" }
  ],
  "functions": {
    "api/cron/rollup-analytics.js": { "maxDuration": 120 },
    "api/og.js": { "regions": ["syd1"], "includeFiles": "node_modules/@vercel/og/dist/**", "maxDuration": 15 },
    "api/bio.js": { "includeFiles": "node_modules/web-bot-auth/**" },
    "api/cv.js": { "includeFiles": "node_modules/web-bot-auth/**" },
    "api/landing.js": { "includeFiles": "node_modules/web-bot-auth/**" },
    "api/track-event.js": { "includeFiles": "node_modules/web-bot-auth/**" }
  }
}
