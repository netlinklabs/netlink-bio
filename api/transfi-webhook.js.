// api/transfi-webhook.js
// Receives order status updates from TransFi (Payin/Onramp events) and
// upserts them into the fiat_orders table. Uses the Supabase service-role
// key because this call comes from TransFi, not from a logged-in user --
// there is no user access token to attach here, so RLS must be bypassed
// deliberately and only from this trusted server-side endpoint.

import crypto from 'crypto';

const SUPABASE_URL = 'https://fuewalufgiclrcgszlit.supabase.co';
const SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;
const TRANSFI_WEBHOOK_SECRET = process.env.TRANSFI_WEBHOOK_SECRET;

// Vercel auto-parses JSON bodies, so req.body is already an object here.
// TransFi's own signing example re-stringifies that parsed body and HMACs
// it -- we mirror that exactly so the hash matches what TransFi computed.
function isValidSignature(body, signatureHeader) {
  if (!signatureHeader || !TRANSFI_WEBHOOK_SECRET) return false;
  const expected = crypto
    .createHmac('sha256', TRANSFI_WEBHOOK_SECRET)
    .update(JSON.stringify(body))
    .digest('hex');
  const a = Buffer.from(expected);
  const b = Buffer.from(signatureHeader);
  if (a.length !== b.length) return false;
  return crypto.timingSafeEqual(a, b);
}

// Unlike the first version of this file, we no longer depend on TransFi
// echoing back a customerOrderId to learn which Netlink user an order
// belongs to. api/transfi-create-order.js already inserts a fiat_orders
// row (with the correct user_id) the moment the order is created, so this
// webhook only ever needs to UPDATE that row by order_id.
async function updateOrderStatus(payload) {
  const order = payload.order || payload.data?.order || {};
  const orderId = order.orderId || payload.entityId || payload.data?.entityId;
  if (!orderId) {
    console.error('Webhook payload has no orderId/entityId, cannot process:', JSON.stringify(payload));
    return;
  }

  const patch = {
    status: payload.status || payload.data?.status || null,
    txn_hash: order.txnHash || null,
    raw_payload: payload,
  };
  // Only overwrite these if TransFi actually sent them -- don't null out
  // values we already had from order creation.
  if (order.cryptoAmount != null) patch.crypto_amount = order.cryptoAmount;
  if (order.walletAddress || order.destinationWalletAddress) {
    patch.wallet_address = order.walletAddress || order.destinationWalletAddress;
  }

  const res = await fetch(`${SUPABASE_URL}/rest/v1/fiat_orders?order_id=eq.${encodeURIComponent(orderId)}`, {
    method: 'PATCH',
    headers: {
      apikey: SERVICE_ROLE_KEY,
      Authorization: `Bearer ${SERVICE_ROLE_KEY}`,
      'Content-Type': 'application/json',
      Prefer: 'return=representation',
    },
    body: JSON.stringify(patch),
  });

  if (!res.ok) {
    const errText = await res.text();
    throw new Error(`Supabase update failed (${res.status}): ${errText}`);
  }
  const updatedRows = await res.json();
  if (updatedRows.length === 0) {
    // No matching row -- most likely this webhook arrived for an order we
    // don't know about yet (e.g. a race with create-order, or an order
    // made outside this flow). Log it; nothing more we can safely do
    // without a Netlink user_id to attach it to.
    console.warn('No fiat_orders row found for TransFi orderId:', orderId);
  }
}

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    res.status(405).json({ error: 'Method not allowed' });
    return;
  }
  if (!SERVICE_ROLE_KEY || !TRANSFI_WEBHOOK_SECRET) {
    console.error('Missing SUPABASE_SERVICE_ROLE_KEY or TRANSFI_WEBHOOK_SECRET env var');
    res.status(500).json({ error: 'Server misconfiguration' });
    return;
  }

  const signature = req.headers['x-transfi-hmac-hash'];
  if (!isValidSignature(req.body, signature)) {
    console.error('Invalid TransFi webhook signature');
    res.status(401).json({ error: 'Invalid signature' });
    return;
  }

  try {
    await updateOrderStatus(req.body);
    // TransFi just needs a 200 to consider delivery successful -- do not
    // add extra latency here (no email/notification side-effects inline).
    res.status(200).json({ received: true });
  } catch (err) {
    console.error('Failed to process TransFi webhook:', err);
    // Still important: TransFi retries on non-2xx, so a real failure here
    // should surface as one -- respond 500 so the event gets retried.
    res.status(500).json({ error: 'Failed to process webhook' });
  }
}
